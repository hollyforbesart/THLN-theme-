{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"gradients": [],
			"palette": [
				{ "name": "Deep Plum", "slug": "plum", "color": "#2E1A47" },
				{ "name": "Medium Purple", "slug": "purple", "color": "#B695D4" },
				{ "name": "Soft Lavender", "slug": "lavender", "color": "#EAD7F5" },
				{ "name": "Warm Cream", "slug": "cream", "color": "#FAF6F0" },
				{ "name": "Warm Sand", "slug": "sand", "color": "#E8C8A8" },
				{ "name": "White", "slug": "white", "color": "#FFFFFF" }
			]
		},
		"typography": {
			"dropCap": false,
			"fontFamilies": [
				{ "name": "Manrope", "slug": "manrope", "fontFamily": "Manrope, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" }
			],
			"fontSizes": [
				{ "name": "Small", "slug": "small", "size": "15px" },
				{ "name": "Body", "slug": "medium", "size": "18px" },
				{ "name": "Lead", "slug": "large", "size": "21px" },
				{ "name": "Heading", "slug": "x-large", "size": "clamp(1.875rem, 1.45rem + 1.6vw, 2.75rem)" },
				{ "name": "Display", "slug": "xx-large", "size": "clamp(2.5rem, 1.6rem + 3.2vw, 4rem)" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1240px"
		}
	}
}
